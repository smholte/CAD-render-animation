{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smholte/toolbox-format/schemas/folder-0.schema.json",
  "title": "toolbox-folder.json \u2013 marks a Toolbox folder (FORMAT.md section 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version"
  ],
  "properties": {
    "format": {
      "const": "toolbox-folder"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    }
  }
}
